---
interface Props {
  label?: string;
  href?: string;
}

const { label, href } = Astro.props;

const opensNewTab = href !== undefined && !href.startsWith("mailto:");

const classes =
  "group/button inline-block text-xl max-h-[50px] hover:scale-110 drop-shadow-lg border-t-2 border-l-2 border-r-4 border-b-4 active:filter-none active:translate-x-[3px] active:translate-y-[3px] px-5 py-2 active:border border-orange-300 dark:border-orange-700 hover:text-primary-500 cursor-pointer rounded-lg";
---

{
  href ? (
    <a
      href={href}
      target={opensNewTab ? "_blank" : undefined}
      rel={opensNewTab ? "noopener" : undefined}
      class={classes}
      aria-label={label ?? ""}
    >
      <slot />
    </a>
  ) : (
    <button class={classes} aria-label={label ?? ""}>
      <slot />
    </button>
  )
}
