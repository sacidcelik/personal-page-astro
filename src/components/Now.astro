---
import Card from "./Card.astro";
import { Icon } from "astro-icon/components";
import { getLang, useTranslations } from "../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));

interface NowContent {
  icon: string;
  description: string;
}

const nowItems: NowContent[] = [
  {
    icon: "line-md--briefcase",
    description: t("now.status"),
  },
  {
    icon: "line-md--map-marker",
    description: t("now.location"),
  },
  {
    icon: "line-md--lightbulb",
    description: t("now.open"),
  },
];
---

<Card
  colSpan="md:col-span-1 lg:col-span-2"
  rowSpan="md:row-span-3 lg:row-span-2"
  order="4"
>
  <h2 class="text-lg font-thin">{t("now.heading")}</h2>
  <div class="flex flex-col gap-2">
    {
      nowItems.map((item) => (
        <div class="flex items-center gap-2">
          <Icon name={item.icon} class="text-2xl" />
          <span class="text-lg">{item.description}</span>
        </div>
      ))
    }
  </div>
</Card>
