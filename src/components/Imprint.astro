---
import Card from "./Card.astro";
import { getLang, useTranslations } from "../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));
---

<Card
  rowSpan="md:row-span-1 lg:row-start-7"
  colSpan="md:col-span-1 lg:col-span-1 lg:col-start-3"
  order="7"
  href="/legal"
>
  <span class="text-sm">{t("imprint.label")}</span>
</Card>
