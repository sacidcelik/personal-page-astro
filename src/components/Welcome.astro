---
import Button from "./Button.astro";
import Card from "./Card.astro";
import { Icon } from "astro-icon/components";
import { getLang, useTranslations } from "../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));

const links = {
  linkedIn: "https://www.linkedin.com/in/sacid-celik",
  github: "https://github.com/sacidcelik",
  mail: "mailto:reach@sacidcelik.de",
};

const buttonCss =
  "group-hover/button:scale-125 group-hover/button:text-orange-400 group-hover/button:dark:text-orange-700";
---

<Card
  colSpan="md:col-span-2 lg:col-start-1"
  rowSpan="md:row-span-4 lg:row-start-1"
  order="1"
>
  <div class="flex h-full">
    <div class="flex flex-col justify-between md:max-h-[300px] gap-4">
      <div class="flex flex-col h-full">
        <h2 class="text-lg font-thin">{t("welcome.heading")}</h2>
        <p class="text-lg">
          {t("welcome.text.intro")} <b>sacid celik</b>{t("welcome.text.rest")}
        </p>
      </div>
      <div class="flex gap-4">
        <Button href={links.github} label="open github profile">
          <Icon class={buttonCss} name="line-md--github" />
        </Button>
        <Button href={links.linkedIn} label="open linkedin profile">
          <Icon class={buttonCss} name="line-md--linkedin" />
        </Button>
      </div>
    </div>
  </div>
</Card>
