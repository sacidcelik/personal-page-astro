---
import Card from "./Card.astro";
import Pill from "./Pill.astro";
import { getLang, useTranslations } from "../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));

const skills = [
  "Angular",
  "TypeScript",
  "JavaScript",
  "React",
  "Astro",
  "Node",
  "Sass",
  "Docker",
];
---

<Card
  colSpan="md:col-span-1 lg:col-span-2"
  rowSpan="md:row-span-6 lg:row-span-1 md:col-start-1 lg:col-start-1 md:row-start-5 lg:row-start-7"
  order="2"
>
  <div class="flex flex-col h-full">
    <h2 class="text-lg font-thin">{t("about.heading")}</h2>
    <p>{t("about.p1")}</p>
    <p class="md:mt-4">{t("about.p2")}</p>
    <div class="flex mt-4 gap-1.5 w-full flex-wrap">
      {skills.map((skill) => <Pill>{skill.toLowerCase()}</Pill>)}
    </div>
  </div>
</Card>
