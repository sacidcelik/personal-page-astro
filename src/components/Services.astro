---
import Card from "./Card.astro";
import { getLang, useTranslations, type Lang } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

interface Service {
  title: string;
  description: string;
}

const servicesByLang: Record<Lang, Service[]> = {
  en: [
    {
      title: "angular development & modernization",
      description:
        "new features, version upgrades and migrations to signals & standalone",
    },
    {
      title: "frontend architecture",
      description:
        "scalable component design, state management and performance tuning",
    },
    {
      title: "fullstack web development",
      description: "apis, tooling and web apps with node and typescript",
    },
    {
      title: "consulting & code reviews",
      description: "supporting your team with audits and best practices",
    },
  ],
  de: [
    {
      title: "angular-entwicklung & modernisierung",
      description:
        "neue features, versions-upgrades und migrationen zu signals & standalone",
    },
    {
      title: "frontend-architektur",
      description:
        "skalierbares komponenten-design, state management und performance-tuning",
    },
    {
      title: "fullstack-webentwicklung",
      description: "apis, tooling und web-apps mit node und typescript",
    },
    {
      title: "consulting & code reviews",
      description: "unterstützung für dein team mit audits und best practices",
    },
  ],
};

const services = servicesByLang[lang];
---

<Card
  colSpan="md:col-span-1 lg:col-span-2 lg:col-start-1"
  rowSpan="md:row-span-1 lg:row-start-9"
  order="8"
>
  <div class="flex flex-col h-full">
    <h2 class="text-lg font-thin">{t("services.heading")}</h2>
    <div class="flex flex-col gap-3 mt-2">
      {
        services.map((service) => (
          <div>
            <h3 class="font-bold">{service.title}</h3>
            <p class="text-sm">{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</Card>
