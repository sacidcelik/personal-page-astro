---
import Card from "./Card.astro";

interface Service {
  title: string;
  description: string;
}

const services: Service[] = [
  {
    title: "angular development & modernization",
    description:
      "new features, version upgrades and migrations to signals & standalone",
  },
  {
    title: "frontend architecture",
    description:
      "scalable component design, state management and performance tuning",
  },
  {
    title: "fullstack web development",
    description: "apis, tooling and web apps with node and typescript",
  },
  {
    title: "consulting & code reviews",
    description: "supporting your team with audits and best practices",
  },
];
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1" order="8">
  <div class="flex flex-col h-full">
    <h2 class="text-lg font-thin">services</h2>
    <div class="flex flex-col gap-3 mt-2">
      {
        services.map((service) => (
          <div>
            <h3 class="font-bold">{service.title}</h3>
            <p class="text-sm">{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</Card>
