---
import Card from "./Card.astro";
import { getLang, useTranslations } from "../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));
---

<Card
  rowSpan="md:row-span-1 lg:row-start-7"
  colSpan="md:col-span-1 lg:col-span-2 lg:col-start-1"
  order="6"
  ><span class="text-sm"
    >{new Date().getFullYear()}. {t("made.before")} <a
      href="https://astro.build"
      target="_blank"
      class="text-orange-700 dark:text-orange-400">astro</a
    >{t("made.after")}
  </span>
</Card>
