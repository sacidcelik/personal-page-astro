---
import Card from "./Card.astro";
import { getLang, useTranslations } from "../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));
---

<Card
  colSpan="md:col-span-2 lg:col-span-1"
  rowSpan="md:row-span-1 lg:row-span-3 lg:row-start-4 lg:col-start-3"
  order="3"
>
  <h2 class="text-lg font-thin">{t("contact.heading")}</h2>
  <p class="text-lg">
    {t("contact.text.before")} <em>reach@sacidcelik.de</em>{" "}
    {t("contact.text.after")}
  </p>
</Card>
