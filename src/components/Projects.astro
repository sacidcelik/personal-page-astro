---
import Card from "./Card.astro";
import Pill from "./Pill.astro";

interface Project {
  title: string;
  description: string;
  stack: string[];
}

const projects: Project[] = [
  {
    title: "solar energy platform",
    description:
      "long-term development of a configuration & commissioning app for solar power systems — owning one of its largest cross-cutting feature modules as sole frontend developer",
    stack: ["angular", "ngrx", "rxjs", "nx"],
  },
  {
    title: "video & event platform",
    description:
      "white-label event platform — new features like in-app chat and architecture decisions across its micro-frontends",
    stack: ["angular", "ngrx", "cypress"],
  },
  {
    title: "ai search mvp",
    description:
      "cognitive search over heterogeneous data sources for an enterprise r&d team — frontend plus api backend, shipped in weeks",
    stack: ["vue", "flask", "azure"],
  },
  {
    title: "websites & shops for small businesses",
    description:
      "consulting, design and development for craft, logistics and retail businesses",
    stack: ["kirby cms", "javascript", "php"],
  },
  {
    title: "this website",
    description:
      "my personal corner of the web, statically generated and lightning fast",
    stack: ["astro", "tailwind", "typescript"],
  },
];
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1" order="9">
  <div class="flex flex-col h-full">
    <h2 class="text-lg font-thin">selected work</h2>
    <div class="flex flex-col gap-3 mt-2">
      {
        projects.map((project) => (
          <div>
            <h3 class="font-bold">{project.title}</h3>
            <p class="text-sm">{project.description}</p>
            <div class="flex mt-2 gap-1.5 w-full flex-wrap">
              {project.stack.map((tech) => (
                <Pill>{tech}</Pill>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <p class="text-sm mt-4">references and further details on request.</p>
  </div>
</Card>
