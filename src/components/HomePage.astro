---
import Welcome from "./Welcome.astro";
import About from "./About.astro";
import Contact from "./Contact.astro";
import Now from "./Now.astro";
import Imprint from "./Imprint.astro";
import Made from "./Made.astro";
import Avatar from "./Avatar.astro";
import Services from "./Services.astro";
import Projects from "./Projects.astro";
---

<main
  class="mx-auto p-3 max-md:pb-8 grid gap-2 max-w-screen-lg overflow-hidden relative w-full sm:p-4 md:grid-cols-2 md:gap-3 md:p-6 lg:grid-cols-4 lg:gap-4 lg:grid-rows-[repeat(8,80px)_auto]"
>
  <Welcome />
  <Avatar />
  <About />
  <Now />
  <Contact />
  <Services />
  <Projects />
  <Imprint />
  <Made />
</main>
