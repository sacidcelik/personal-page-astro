---
import Welcome from "./Welcome.astro";
import About from "./About.astro";
import Contact from "./Contact.astro";
import Now from "./Now.astro";
import Imprint from "./Imprint.astro";
import Made from "./Made.astro";
import Avatar from "./Avatar.astro";
import Services from "./Services.astro";
import Projects from "./Projects.astro";
---

<div class="absolute right-0 top-4 z-10 md:top-8"></div>

<main
  class="mx-auto p-3 grid gap-2 max-w-screen-lg overflow-hidden relative w-full sm:p-4 md:grid-cols-2 md:gap-3 md:p-6 lg:h-[800px] lg:grid-rows-8 lg:grid-cols-4 lg:gap-4"
>
  <Welcome />
  <Avatar />
  <About />
  <Now />
  <Contact />
  <Made />
  <Imprint />
</main>

<section
  class="mx-auto p-3 grid gap-2 max-w-screen-lg relative w-full sm:p-4 md:grid-cols-2 md:gap-3 md:p-6 lg:gap-4"
>
  <Services />
  <Projects />
</section>
